{
  "buildCommand": "bash scripts/build-web-vercel.sh",
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0"}
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0"}
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {"key": "Cache-Control", "value": "no-cache"}
      ]
    }
  ]
}
